# Names only, never values. The real file lives on the VM at
# ~/scrumboard-api/.env and never passes through GitHub.

# Layer 2 of the access control (00-scope.md §6.1). At least 16 characters.
# Generate one with: openssl rand -base64 32
SCRUMBOARD_TOKEN=

# Where the SQLite file lives. In the container this is the mounted volume.
DB_PATH=/data/scrumboard.db

# The port inside the container. nginx on the host maps 127.0.0.1:8020 to it.
PORT=8080

# The single origin allowed to call the API. Never "*".
CORS_ORIGIN=https://scrumboard.alejandrogmota.com
